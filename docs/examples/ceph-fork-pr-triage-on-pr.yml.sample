# SAMPLE for ceph/ceph fork: .github/workflows/pr-triage-on-pr.yml
# On each pull_request, query similar/duplicate/overlap signals (read-only Summary).

name: pr-triage on PR

on:
  pull_request:
    types: [opened, synchronize, reopened]

permissions:
  contents: read
  actions: read

concurrency:
  group: pr-triage-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  triage:
    uses: RaminNietzsche/pr-triage/.github/workflows/reusable-query-pr.yml@main
    with:
      pr_number: ${{ github.event.pull_request.number }}
      config: configs/ceph.yml
      tool_ref: main
      kb_workflow_file: pr-triage-kb.yml
      all_findings: true
      refresh_target: true
    secrets: inherit
